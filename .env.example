# App Configuration
NEXT_PUBLIC_APP_NAME="Dataloop"
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Cryptography & Security (32-byte hex for AES-256-GCM envelope encryption)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Database & Supabase (Postgres + RLS)
# Direct connection string to Supabase Postgres (Transaction pooler on port 6543 or session on 5432)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
# Supabase Project URL & Anon Key (Client-accessible)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Supabase Service Role Key (SERVER ONLY - Never expose to client bundles)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."


# Email (Resend)
RESEND_API_KEY="re_..."
FROM_EMAIL="notifications@dataloop.io"

# Background Job Queue (Inngest)
INNGEST_EVENT_KEY="test_event_key"
INNGEST_SIGNING_KEY="test_signing_key"

# Observability
SENTRY_DSN="https://key@sentry.io/project"

# OAuth Integrations (Least-privilege credentials)
# Google Sheets & Google Drive
GOOGLE_CLIENT_ID="google_client_id_placeholder.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# Airtable OAuth
AIRTABLE_CLIENT_ID="airtable_client_id_placeholder"
AIRTABLE_CLIENT_SECRET="airtable_client_secret_placeholder"

# Notion OAuth
NOTION_CLIENT_ID="notion_client_id_placeholder"
NOTION_CLIENT_SECRET="secret_..."

# HubSpot OAuth
HUBSPOT_CLIENT_ID="hubspot_client_id_placeholder"
HUBSPOT_CLIENT_SECRET="hubspot_client_secret_placeholder"
